# Copy to .env for local deployments, or configure these values in your hosting
# platform's secret manager / environment settings.
# Do NOT commit the real .env file.

# ----------------------------------------------------------------------------
# App security
# ----------------------------------------------------------------------------
# Optional: require this header value as x-api-key for API routes.
MPT_APP_API_KEY=

# ----------------------------------------------------------------------------
# Core AI video pipeline
# ----------------------------------------------------------------------------
# Pick the provider you actually use in MoneyPrinterTurbo.
MPT_APP_LLM_PROVIDER=openai

# Example cloud LLM secret. Replace with the provider key that matches
# MPT_APP_LLM_PROVIDER, e.g. MPT_APP_OPENAI_API_KEY, MPT_APP_MOONSHOT_API_KEY,
# MPT_APP_GEMINI_API_KEY, MPT_APP_CLAUDE_API_KEY, etc.
MPT_APP_OPENAI_API_KEY=

# Stock video provider for the default automated workflow.
MPT_APP_PEXELS_API_KEYS=
# Optional alternatives if you do not use Pexels.
MPT_APP_PIXABAY_API_KEYS=
MPT_APP_COVERR_API_KEYS=

# Optional thumbnail / AI-image generation. Needed only when thumbnail_enabled=true
# or video_source=openai_image.
MPT_APP_OPENAI_IMAGE_BASE_URL=
MPT_APP_OPENAI_IMAGE_MODEL=
MPT_APP_OPENAI_IMAGE_API_KEYS=

# Optional cloud TTS. Edge TTS works without any API key, so these can remain empty.
MPT_AZURE_SPEECH_KEY=
MPT_AZURE_SPEECH_REGION=
MPT_ELEVENLABS_API_KEY=
MPT_SILICONFLOW_API_KEY=
MPT_MINIMAX_TTS_API_KEY=
MPT_FISH_AUDIO_API_KEY=

# ----------------------------------------------------------------------------
# Upload-Post / YouTube publishing
# ----------------------------------------------------------------------------
# MoneyPrinterTurbo's current YouTube publishing integration uses Upload-Post.
# First connect and authorize your own YouTube channel in Upload-Post, then set:
MPT_APP_UPLOAD_POST_ENABLED=true
MPT_APP_UPLOAD_POST_API_KEY=
MPT_APP_UPLOAD_POST_USERNAME=
MPT_APP_UPLOAD_POST_PLATFORMS=youtube
MPT_APP_UPLOAD_POST_AUTO_UPLOAD=false
MPT_APP_UPLOAD_POST_YOUTUBE_PRIVACY_STATUS=public

# ----------------------------------------------------------------------------
# Automated Shorts scheduler
# ----------------------------------------------------------------------------
# These are non-secret convenience settings; you can also change them in the
# automation dashboard, which writes to config.toml.
MPT_AUTOMATION_ENABLED=false
MPT_AUTOMATION_YOUTUBE_AUTHORIZATION_CONFIRMED=false
MPT_AUTOMATION_AUTO_GENERATE=true
MPT_AUTOMATION_AUTO_UPLOAD=true
MPT_AUTOMATION_NICHE=AI tools for Indian students and freelancers
MPT_AUTOMATION_LANGUAGE=hi-IN
MPT_AUTOMATION_VIDEO_DURATION_SECONDS=45
MPT_AUTOMATION_DAILY_UPLOAD_TIME=09:00
MPT_AUTOMATION_VIDEOS_PER_DAY=1
MPT_AUTOMATION_TITLE_DESCRIPTION_STYLE=Practical, curiosity-driven, trustworthy, no hype
MPT_AUTOMATION_VIDEO_SOURCE=pexels
MPT_AUTOMATION_VOICE_NAME=
MPT_AUTOMATION_THUMBNAIL_ENABLED=true
MPT_AUTOMATION_GENERATION_RETRY_ATTEMPTS=2
MPT_AUTOMATION_UPLOAD_RETRY_ATTEMPTS=3
MPT_AUTOMATION_RETRY_BACKOFF_MINUTES=30
MPT_AUTOMATION_POLL_INTERVAL_SECONDS=30
MPT_AUTOMATION_HISTORY_LIMIT=200
